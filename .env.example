# Démonstration locale seulement. Copier vers backend/.env, ne jamais commiter les secrets.
# En mode secure, remplacer TOUS les mots de passe de bases et fournir les secrets ci-dessous.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=urbanbutterfly

MONGO_URI=mongodb://admin:urbanbutterfly@localhost:27017
MONGO_DB=urban_butterfly

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# demo : anciennes fonctionnalités locales sans connexion (JAMAIS exposer sur Internet).
# secure : sessions, rôles, clé d'agence et journal des actions.
SECURITY_MODE=demo
# AUTH_OPERATOR_PASSWORD=une-longue-phrase-aleatoire
# AUTH_VIEWER_PASSWORD=une-autre-longue-phrase-aleatoire
# AUTH_AGENCY_KEY=un-secret-aleatoire-de-plus-de-32-caracteres
# AUTH_COOKIE_SECURE=true
# AUTH_ALLOWED_ORIGINS=https://console.example.org
